APP_NAME=HR/Ed Tech API
ENVIRONMENT=local
API_V1_PREFIX=/api/v1

GEMINI_API_KEY=
OPENROUTER_API_KEY=
AIAI_API_KEY=

AI_DEFAULT_PROVIDER=openrouter
AI_CORS_ORIGINS=http://localhost:5273,https://localhost:5273,https://albionvisual.github.io
AI_TIMEOUT_SECONDS=120
AI_MAX_MESSAGES=100
AI_MAX_MESSAGE_CHARS=50000

AI_RATE_LIMIT_REQUESTS=30
AI_RATE_LIMIT_WINDOW_SECONDS=60
RESUME_PARSE_CONCURRENCY=1

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hrtech
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2
DATABASE_ECHO=false

GOOGLE_CLIENT_ID=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_REDIRECT_URI=http://localhost:8000/api/v1/auth/telegram/callback
APP_PUBLIC_URL=https://localhost:5273
SESSION_SECRET=change-me
SESSION_COOKIE_NAME=session
SESSION_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
