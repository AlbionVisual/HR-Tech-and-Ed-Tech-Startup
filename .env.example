# Скопируйте в .env и заполните значения.
# .env не коммитится в git.

# --- Образы (собираются в GitHub Actions, публикуются в GHCR) ---
BACKEND_IMAGE=ghcr.io/albionvisual/hr-tech-and-ed-tech-startup/backend
FRONTEND_IMAGE=ghcr.io/albionvisual/hr-tech-and-ed-tech-startup/frontend
# На VPS deploy workflow подставляет sha-<commit>. Для ручного запуска: latest.
IMAGE_TAG=latest

# --- Домен и TLS ---
# Для VPS: app.example.com. Для локального запуска: localhost.
APP_DOMAIN=localhost
ENVIRONMENT=production

# --- PostgreSQL ---
POSTGRES_USER=postgres
# Смените на длинный URL-safe пароль (без @ : / # ? $ %).
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hrtech
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2
DATABASE_ECHO=false

# --- API ---
APP_NAME=HR/Ed Tech API
GEMINI_API_KEY=
OPENROUTER_API_KEY=
AIAI_API_KEY=
AI_DEFAULT_PROVIDER=openrouter
AI_CORS_ORIGINS=https://localhost
AI_TIMEOUT_SECONDS=120
AI_MAX_MESSAGES=100
AI_MAX_MESSAGE_CHARS=50000

# --- Ограничения под 1 vCPU ---
# Не больше N AI-запросов на пользователя за окно в секундах.
AI_RATE_LIMIT_REQUESTS=30
AI_RATE_LIMIT_WINDOW_SECONDS=60
# Сколько PDF/DOCX можно парсить одновременно.
RESUME_PARSE_CONCURRENCY=1

# --- Авторизация ---
GOOGLE_CLIENT_ID=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_REDIRECT_URI=https://localhost/api/v1/auth/telegram/callback
APP_PUBLIC_URL=https://localhost
# Сгенерируйте: openssl rand -hex 32
SESSION_SECRET=change-me
SESSION_COOKIE_NAME=session
SESSION_TTL_DAYS=30
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
