{$APP_DOMAIN:localhost} {
	encode zstd gzip

	request_body {
		max_size 16MB
	}

	handle /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle /docs* {
		reverse_proxy api:8000
	}

	handle /redoc* {
		reverse_proxy api:8000
	}

	handle /openapi.json {
		reverse_proxy api:8000
	}

	handle /health {
		reverse_proxy api:8000
	}

	handle /ready {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy frontend:80
	}
}
